# Open Ried Sens - Next.js Environment Variables

# 1. Admin Control Panel Password
# Password used by administrators to log into the /admin dashboard
ADMIN_PASSWORD=YourSuperSecureAdminPassword2026!

# 2. VPS Telemetry Backend URL
# In local development: http://localhost:8080
# In production: https://api.your-domain.de (or http://<VPS-IP>:8080)
BACKEND_API_URL=http://localhost:8080

# 3. VPS Backend Admin API Key
# Matches ADMIN_API_KEY set on the VPS FastAPI service
BACKEND_ADMIN_API_KEY=open-ried-sens-admin-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
